  "components": [
    {
      "name": "Flight strip",
      "kind": "custom",
      "refersTo": "strip-pr",
      "description": "A thread as a printed strip in its holder: callsign, title, last move, silence.",
      "html": "<div class=\"ds-holder\" data-state=\"stalled\"><div class=\"ds-paper\"><span class=\"ds-cs\"><b>LU</b> 881<small>ISSUE</small></span><span class=\"ds-body\"><span class=\"ds-title\">Popover loses focus on scroll</span><span class=\"ds-note\">Nobody has replied in 19 days</span></span><span class=\"ds-quiet\"><b>19</b><small>DAYS</small></span></div></div>",
      "css": ".ds-holder{position:relative;display:flex;padding:3px 3px 3px 9px;border-radius:5px;background:var(--holder,#0c0f12);box-shadow:inset 0 1px 0 var(--holder-lip,#303843);max-width:560px}.ds-holder::before{content:'';position:absolute;left:2px;top:3px;bottom:3px;width:4px;border-radius:2px;background:var(--pencil,#d0352a)}.ds-paper{display:grid;grid-template-columns:6.4em minmax(0,1fr) 4.4em;flex:1;min-height:50px;border-radius:3px;background:var(--strip-issue,#b6d3f0);color:var(--strip-ink,#15181c);transition:transform 260ms cubic-bezier(0.22,1,0.36,1)}.ds-paper:hover{transform:translateX(4px)}.ds-paper>*+*{border-left:1px solid rgba(21,24,28,.22)}.ds-cs{display:grid;align-content:center;padding:5px 8px 5px 10px;font-family:'Martian Mono',ui-monospace,monospace;font-variation-settings:'wdth' 78;font-size:13px}.ds-cs small{margin-top:3px;font:700 10px/1 Archivo,sans-serif;letter-spacing:.12em;color:#45474a}.ds-body{display:grid;align-content:center;padding:6px 12px;min-width:0}.ds-title{font:600 15px/1.25 Archivo,sans-serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-note{font:400 13px/1.3 Archivo,sans-serif;color:#45474a}.ds-quiet{display:grid;justify-items:center;align-content:center;line-height:1}.ds-quiet b{font:700 19px 'Martian Mono',monospace;font-variation-settings:'wdth' 78}.ds-quiet small{margin-top:4px;font:700 10px Archivo,sans-serif;letter-spacing:.1em;color:#45474a}"
    },
    {
      "name": "Strip action",
      "kind": "button",
      "refersTo": "strip-link-primary",
      "description": "The primary action: a strip in its holder that slides when pulled.",
      "html": "<a class=\"ds-strip-link\" href=\"#\"><span class=\"ds-strip-link-paper\">Connect GitHub<span class=\"ds-strip-link-icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></span></span></a>",
      "css": ".ds-strip-link{display:inline-flex;padding:3px 3px 3px 9px;border-radius:5px;background:var(--holder,#0c0f12);box-shadow:inset 0 1px 0 var(--holder-lip,#303843);color:var(--strip-ink,#15181c);text-decoration:none}.ds-strip-link-paper{display:flex;align-items:center;gap:18px;min-height:52px;padding:0 8px 0 18px;border-radius:3px;background:var(--strip-pr,#f1dfa6);font:700 17px Archivo,sans-serif;transition:transform 260ms cubic-bezier(0.22,1,0.36,1)}.ds-strip-link-icon{display:grid;place-items:center;width:34px;height:34px;border-left:1px solid rgba(21,24,28,.22)}.ds-strip-link:hover .ds-strip-link-paper{transform:translateX(6px)}.ds-strip-link:focus-visible{outline:2px solid var(--focus,#ffb21e);outline-offset:3px}"
    },
    {
      "name": "Quiet strip action",
      "kind": "button",
      "refersTo": "strip-link-quiet",
      "description": "The secondary action: an empty holder outline.",
      "html": "<a class=\"ds-strip-quiet\" href=\"#\">Open the sample board</a>",
      "css": ".ds-strip-quiet{display:inline-flex;align-items:center;min-height:58px;padding:0 20px;border-radius:5px;box-shadow:inset 0 0 0 1px var(--rule-2,#3b4551);color:var(--ink,#eef1f3);font:700 17px Archivo,sans-serif;text-decoration:none}.ds-strip-quiet:hover{background:var(--bay-2,#212831)}.ds-strip-quiet:focus-visible{outline:2px solid var(--focus,#ffb21e);outline-offset:3px}"
    },
    {
      "name": "Bay plate",
      "kind": "chip",
      "refersTo": "bay-plate-you",
      "description": "The designator printed on a bay's header; amber only for Your move.",
      "html": "<span class=\"ds-plate\">Your move</span> <span class=\"ds-plate ds-plate-them\">Their move</span> <span class=\"ds-plate ds-plate-stalled\">Stalled</span>",
      "css": ".ds-plate{display:inline-block;padding:4px 9px 3px;border-radius:3px;background:var(--move,#ffb21e);color:var(--move-ink,#1d1404);font:800 13px/1.2 Archivo,sans-serif;font-variation-settings:'wdth' 78;letter-spacing:.12em;text-transform:uppercase}.ds-plate-them{background:var(--bay-3,#2a323c);color:var(--ink,#eef1f3)}.ds-plate-stalled{background:var(--pencil,#d0352a);color:#fff}"
    },
    {
      "name": "Callsign",
      "kind": "chip",
      "refersTo": "callsign",
      "description": "A repo's short printed code, unique among the repos on screen.",
      "html": "<span class=\"ds-callsign\">QR</span>",
      "css": ".ds-callsign{display:inline-flex;align-items:center;justify-content:center;min-width:3.1em;height:1.9em;padding:0 .45em;border-radius:3px;box-shadow:inset 0 0 0 1px var(--rule-2,#3b4551);color:var(--ink,#eef1f3);font:700 13px 'Martian Mono',monospace;font-variation-settings:'wdth' 78;letter-spacing:.08em}"
    },
    {
      "name": "Picked chip",
      "kind": "chip",
      "refersTo": "strip-plain",
      "description": "A topic or filter that is on: plain paper in a holder ring.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"false\">rust</button> <button class=\"ds-chip\" aria-pressed=\"true\">typescript</button>",
      "css": ".ds-chip{height:36px;padding:0 14px;border:0;border-radius:4px;background:var(--bay-2,#212831);box-shadow:inset 0 0 0 1px var(--rule-2,#3b4551);color:var(--ink-2,#b3bcc6);font:600 15px Archivo,sans-serif;cursor:pointer}.ds-chip:hover{background:var(--bay-3,#2a323c);color:var(--ink,#eef1f3)}.ds-chip[aria-pressed=true]{background:var(--strip-plain,#e6eaee);box-shadow:0 0 0 3px var(--holder,#0c0f12);color:var(--strip-ink,#15181c)}.ds-chip:focus-visible{outline:2px solid var(--focus,#ffb21e);outline-offset:3px}"
    },
    {
      "name": "Token field",
      "kind": "input",
      "refersTo": "strip-plain",
